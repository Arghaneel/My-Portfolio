# Copy this file to .env.local and fill in what you need. Never commit real keys.

# ── GitHub dashboard ─────────────────────────────────────────────
GITHUB_USERNAME=Arghaneel
# Optional. Without it the dashboard still shows live data, but GitHub only
# allows 60 API requests/hour. A token raises that to 5,000/hour.
# Create one at https://github.com/settings/tokens (classic, no scopes needed).
GITHUB_TOKEN=

# ── LeetCode dashboard ───────────────────────────────────────────
LEETCODE_USERNAME=arghaneel_das

# ── Contact form (https://resend.com – free tier is enough) ─────
# Without RESEND_API_KEY the form tells visitors to email you directly.
RESEND_API_KEY=
CONTACT_TO_EMAIL=arghaneeldas29@gmail.com
# Leave as-is until you verify your own domain in Resend.
CONTACT_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>

# ── Deployment ───────────────────────────────────────────────────
# Your live URL, used for link previews (e.g. https://arghaneel.vercel.app)
NEXT_PUBLIC_SITE_URL=
